#!/usr/bin/env python
"""Local hygiene guard. Full validation is the documented check command."""
import subprocess
import sys
from pathlib import Path

root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(root))
from tools.check import hygiene

errors = hygiene(root)
if errors:
    print(chr(10).join(errors))
    raise SystemExit(1)
