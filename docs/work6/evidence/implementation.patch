+    save(base / "installed-source.json", identity)
+    save(
+        base / "runtime.json",
+        dict(
+            version=version("zaratustra"),
+            package=str(package),
+            python=sys.version,
+            sqlite=sqlite3.sqlite_version,
+            pydantic=pydantic.__version__,
