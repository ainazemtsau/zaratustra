{
  "name": "zaratustra",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Durable Work and addressed materials for Pi; full R1 remains in development",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "pi": {
    "extensions": [
      "src/extension/index.ts"
    ],
    "skills": [
      "skills/zaratustra-work",
      "skills/zaratustra-memory",
      "skills/zaratustra-sleep",
      "skills/zaratustra-documents"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0 <1.5.0",
    "typebox": "*"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "htmlparser2": "12.0.0",
    "pdfjs-dist": "6.4.299",
    "yauzl": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "22.18.6",
    "dependency-cruiser": "17.1.0",
    "eslint": "9.38.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts",
    "types": "tsc --noEmit",
    "boundary": "depcruise src --config .dependency-cruiser.cjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run types && npm run boundary && npm run build && npm test",
    "deliver": "npm run check && node scripts/deliver.mjs"
  }
}
