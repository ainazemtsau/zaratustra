{
  "name": "zaratustra",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "description": "First-block durable continuation for Pi; full R1 remains in development",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.6.2",
  "pi": {
    "extensions": [
      "src/extension/index.ts"
    ],
    "skills": [
      "skills/zaratustra-work",
      "skills/zaratustra-memory"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "prettier": "3.6.2",
    "eslint": "9.38.0",
    "typescript-eslint": "8.46.2",
    "dependency-cruiser": "17.1.0",
    "typebox": "1.3.27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts",
    "types": "tsc --noEmit",
    "boundary": "depcruise src --config .dependency-cruiser.cjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run types && npm run boundary && npm run build && npm test",
    "deliver": "npm run check && node scripts/deliver.mjs"
  }
}
